---
const title = 'Felipe Alves';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Felipe Alves: data, product and transformation. The portfolio is being rebuilt." />
    <style>
      body { font-family: Georgia, 'Times New Roman', serif; margin: 0; background: #faf7f2; color: #1d1b18; }
      main { max-width: 36rem; margin: 18vh auto 0; padding: 0 1.5rem; }
      h1 { font-size: 2.2rem; margin: 0 0 0.5rem; }
      p { line-height: 1.6; }
      a { color: inherit; }
    </style>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <p>Data, product and transformation. This site is being rebuilt.</p>
      <p>
        The current portfolio is at
        <a href="https://portfolio-six-sigma-52.vercel.app">portfolio-six-sigma-52.vercel.app</a>.
      </p>
    </main>
  </body>
</html>
