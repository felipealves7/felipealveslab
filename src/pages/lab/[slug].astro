---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AirportHero from '../../components/AirportHero.astro';
import AirportReplay from '../../components/AirportReplay.astro';
import LabEvidenceChart from '../../components/LabEvidenceChart.astro';
import AirportNotebook from '../../components/AirportNotebook.astro';
import AviationHero from '../../components/AviationHero.astro';
import AviationExplorer from '../../components/AviationExplorer.astro';
import AviationDistribution from '../../components/AviationDistribution.astro';
import AviationNotebook from '../../components/AviationNotebook.astro';
import AviationElsewhere from '../../components/AviationElsewhere.astro';
import AltairCharts from '../../components/AltairCharts.astro';
import pldResults from '../../../data/ccee-pld/results.json';
import pldSpec from '../../charts/pld-daily.vl.json';
import airportResults from '../../../data/airport-contract/results.json';
import ledgerEvalResults from '../../../data/ledger-eval/results.json';
import { fillLabCharts, airportChart, ledgerChart } from '../../lib/lab/svg-charts.mjs';
import { pldFigure } from '../../lib/charts/pld.mjs';
import { wrapTables } from '../../lib/lab/prose.mjs';

export async function getStaticPaths() {
  const entries = await getCollection('lab');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
// Build-time SVG charts replace their markers in the rendered Markdown, so they sit inside the page's sections.
// The PLD chart is made with Altair (charts/pld_daily.py) and drawn here; src/lib/charts/live.mjs runs it in the browser.
// Every table then sits in a container that scrolls sideways on a phone.
const pldHtml = entry.id === 'brazil-power-price-contract' ? await pldFigure(pldResults, pldSpec) : '';
const body = wrapTables(fillLabCharts(entry.rendered?.html ?? '', {
  pld: () => pldHtml,
  airport: () => airportChart(airportResults),
  ledger: () => ledgerChart(ledgerEvalResults),
}));
const d = entry.data;
const fmt = (date: Date) => date.toISOString().slice(0, 10);
const DEMOS: Record<string, string> = { 'ask-the-ledger': '/js/ledger-demo.js', 'brazil-power-price-contract': '/js/pld-explorer.js' };
const demoScript = DEMOS[entry.id];
const extraScript = entry.id === 'ask-the-ledger' ? '/js/ledger-live.js' : undefined;
const isAirport = entry.id === 'airport-data-contract';
const isLedger = entry.id === 'ask-the-ledger';
const isAviation = entry.id === 'aviation-reliability';
const isPld = entry.id === 'brazil-power-price-contract';
const isDst = entry.id === 'spring-clock-change-road-deaths';
const label = d.series === 'human-variable' ? 'The Human Variable' : d.lane;
const css = ['styles', 'responsive', 'enhancements', 'site-fixes', 'illustrations', 'lab', ...(isAirport ? ['lab-airport'] : []), 'lab-proof', ...(isAirport || isLedger || isPld ? ['lab-charts'] : []), ...(isAviation ? ['lab-aviation'] : []), ...(isPld ? ['lab-pld', 'altair-charts'] : []), ...(isDst ? ['lab-dst'] : [])];
---
<Base
  title={`${d.title} — Felipe Alves Lab`}
  description={d.question}
  ogType="article"
  css={css}
  bodyClass="case-page"
  script="script"
  current="lab"
>
  <main>
    <nav class="section-shell lab-breadcrumb" aria-label="Breadcrumb"><a href="/">Felipe Alves</a><span aria-hidden="true">/</span><a href="/lab">Lab</a><span aria-hidden="true">/</span><span aria-current="page">{d.title}</span></nav>
    {isAirport ? (
      <AirportHero type={d.type} />
    ) : isAviation ? (
      <AviationHero type={d.type} />
    ) : (
      <section class="case-hero section-shell reveal">
        <div>
          <span class="eyebrow">Lab exhibit · {label}</span>
          <h1>{d.title}</h1>
          <p>{d.question}</p>
          <span class="lab-provenance">In source · recorded evidence</span>
        </div>
        <div class="case-facts">
          <div><span>Type</span><strong>{d.type}</strong></div>
          <div><span>Dataset</span><strong>{d.synthetic ? 'Synthetic' : 'Public'} · as recorded {fmt(d.dataFreshness)}</strong></div>
          <div><span>Licence</span><strong>{d.dataLicence}</strong></div>
          <div><span>Running cost</span><strong>{d.runningCost}</strong></div>
        </div>
      </section>
    )}
    {(isAirport || isLedger) && (
      <section class="section-shell lab-evidence-detail" aria-label="Recorded evidence chart">
        <div class="lab-evidence-intro"><span class="eyebrow">Evidence / chart</span><h2>Read the result before the explanation.</h2></div>
        <LabEvidenceChart exhibit={isAirport ? 'airport' : 'ledger'} />
      </section>
    )}
    {isAirport && <div class="section-shell"><AirportNotebook /></div>}
    {isAviation && <AviationExplorer />}
    {isAviation && <AviationDistribution />}
    {isAviation && <AviationElsewhere />}
    {isAviation && <div class="section-shell"><AviationNotebook /></div>}
    <section class="section-shell lab-body">
      <div class="lab-prose"><Fragment set:html={body} /></div>
    </section>
  </main>
  {isAirport && <AirportReplay />}
  {isPld && <AltairCharts />}
  {demoScript && <script is:inline src={demoScript}></script>}
  {extraScript && <script is:inline src={extraScript}></script>}
</Base>
