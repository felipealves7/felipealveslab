---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LabEvidenceChart from '../../components/LabEvidenceChart.astro';

const entries = (await getCollection('lab')).sort((a, b) => (b.data.published?.getTime() ?? 0) - (a.data.published?.getTime() ?? 0));
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Base
  title="Lab — evidence behind the work | Felipe Alves"
  description="Recorded, checkable analytics and data engineering experiments with methods, charted results and limitations."
  css={['styles', 'responsive', 'enhancements', 'site-fixes', 'illustrations', 'lab', 'lab-proof']}
  bodyClass="case-page"
  script="script"
  current="lab"
>
  <main>
    <section class="section-shell lab-directory-hero">
      <span class="eyebrow">Felipe Alves / Data &amp; AI Lab</span>
      <h1>Working evidence, not another list of tools.</h1>
      <p>The portfolio describes professional decisions. This section shows code, recorded results, and failure modes. Numbers below are drawn from files in the public repository. They are not claims of live-service verification.</p>
      <div class="hero-actions"><a class="button primary" href="https://www.linkedin.com/in/felipealves7" target="_blank" rel="noreferrer">LinkedIn ↗</a><a class="button ghost" href="/#work">Professional work</a></div>
    </section>
    <section class="section-shell lab-directory" aria-label="Published Lab exhibits">
      <div class="lab-section-heading"><div><span class="eyebrow">Recorded exhibits</span><h2>Open an experiment. Inspect the evidence.</h2></div><p>In source = backed by checked-in code and saved output. It does not imply that a hosted feature was tested today.</p></div>
      <div class="lab-directory-grid">
        {entries.map((entry) => (
          <article class="lab-directory-card">
            <div class="lab-directory-card-copy">
              <div class="lab-card-overline"><span>{entry.data.lane}</span><span class="lab-provenance">In source</span></div>
              <h3><a href={`/lab/${entry.id}`}>{entry.data.title}</a></h3>
              <p>{entry.data.question}</p>
              <p class="lab-card-meta">{entry.data.type} · {entry.data.synthetic ? 'synthetic' : 'public'} data · recorded {fmt(entry.data.dataFreshness)}</p>
              <a class="text-link" href={`/lab/${entry.id}`}>Explore evidence and method →</a>
            </div>
            {entry.id === 'ask-the-ledger' && <LabEvidenceChart exhibit="ledger" compact />}
            {entry.id === 'airport-data-contract' && <LabEvidenceChart exhibit="airport" compact />}
            {entry.id !== 'ask-the-ledger' && entry.id !== 'airport-data-contract' && (
              <div class="lab-source-note">A recorded chart can be added when this experiment has a validated result dataset. No placeholder values are shown.</div>
            )}
          </article>
        ))}
      </div>
      {entries.length === 0 && <p>There are no published experiments in the checked-in content collection.</p>}
    </section>
    <section class="section-shell lab-next-section">
      <span class="eyebrow">Planned · not yet published here</span>
      <h2>External analytics and companion exhibits.</h2>
      <p>Public Tableau, Kaggle and other hosted work will be linked or embedded only after its exact URL, permissions, data provenance and fallback have been reviewed. Related professional case-study demonstrations will use public or clearly synthetic data rather than employer datasets.</p>
      <a class="text-link" href="/#work">Review professional case studies →</a>
    </section>
  </main>
</Base>
