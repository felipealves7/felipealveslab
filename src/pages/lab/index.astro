---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const entries = (await getCollection('lab')).sort((a, b) => (b.data.published?.getTime() ?? 0) - (a.data.published?.getTime() ?? 0));
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Base
  title="Data & AI Lab — Felipe Alves"
  description="Small, checkable experiments in data and AI by Felipe Alves. Each one shows its data, its method and what failed."
  css={['styles', 'responsive', 'enhancements', 'site-fixes', 'illustrations', 'lab']}
  bodyClass="case-page"
  script="script"
  current="lab"
>
  <main>
    <section class="case-hero section-shell reveal">
      <div>
        <span class="eyebrow">Data &amp; AI Lab</span>
        <h1>Small experiments you can check.</h1>
        <p>
          Each project asks one question, shows the data it used, runs from saved output with no live services, and says
          what failed. AI agents propose and draft the work. Felipe reviews and approves everything that is published.
        </p>
      </div>
    </section>
    <section class="section-shell lab-list">
      {entries.length === 0 && <p>No experiments yet.</p>}
      <div class="decision-grid">
        {entries.map((e) => (
          <a class="decision-card lab-card" href={`/lab/${e.id}`}>
            <span>{e.data.lane} · {e.data.type}</span>
            <h3>{e.data.title}</h3>
            <p>{e.data.question}</p>
            <p class="lab-meta">
              {e.data.synthetic ? 'Synthetic data' : 'Public data'} · data as of {fmt(e.data.dataFreshness)} · {e.data.runningCost}
            </p>
          </a>
        ))}
      </div>
    </section>
  </main>
</Base>
