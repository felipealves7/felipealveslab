---
import Base from '../layouts/Base.astro';
---
<Base
  title="Page not found — Felipe Alves"
  description="This page does not exist."
  css={['styles', 'responsive', 'enhancements', 'site-fixes']}
  bodyClass="milestones-page"
  script="script"
>
  <main>
    <section class="closing section-shell">
      <span class="eyebrow">404</span>
      <h2>That page is not here.</h2>
      <p>It may have moved while the site was rebuilt.</p>
      <div class="closing-actions">
        <a class="button primary" href="/">Home</a>
        <a class="button ghost" href="/#work">Selected work</a>
      </div>
    </section>
  </main>
</Base>
