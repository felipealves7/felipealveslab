---
// The live piece on /lab/aviation-reliability: one measure at a time, by month, the latest year
// against the year before, from the saved monthly totals. The chart is made with Altair
// (charts/aviation_months.py) and drawn when the site is built (src/lib/charts/aviation.mjs); with
// JavaScript the buttons pick the measure. "Show the numbers" lists every value.
import monthsCsv from '../../data/aviation-reliability/mart_month.csv?raw';
import { parseMonths } from '../lib/aviation/metrics.mjs';
import { monthsFigure } from '../lib/charts/aviation.mjs';

const rows = parseMonths(monthsCsv);
const years = [...new Set((rows as unknown as { year: number }[]).map((r) => r.year))].sort((a, b) => a - b);
const [y0, y1] = [years[0], years[years.length - 1]];
const lastMonth = Math.max(...(rows as unknown as { year: number; month: number }[]).filter((r) => r.year === y1).map((r) => r.month));
const lastName = new Date(Date.UTC(2000, lastMonth - 1, 1)).toLocaleString('en-GB', { month: 'long', timeZone: 'UTC' });
const figure = await monthsFigure(rows);
---
<section class="av-explorer section-shell" aria-labelledby="av-explorer-title">
  <div class="av-section-head">
    <span class="eyebrow">The live piece · from the saved monthly totals</span>
    <h2 id="av-explorer-title">Pick a measure. Compare the months.</h2>
    <p>{y0} in gray, as context. {y1} in olive, from January to {lastName}, the latest month published. Hover, tap or use the arrow keys for both years' values.</p>
  </div>
  <Fragment set:html={figure} />
</section>
