---
// Evidence is compiled from checked-in files. No hardcoded metrics and no request at runtime. The
// chart is one of the site's Altair charts (src/lib/charts/evidence.mjs): drawn at card sizes on the
// Lab hub, and live with its readout at the top of an exhibit page.
import ledgerData from '../../data/ask-the-ledger/results.json';
import airportData from '../../data/airport-contract/results.json';
import aviationMonths from '../../data/aviation-reliability/mart_month.csv?raw';
import pldData from '../../data/ccee-pld/results.json';
import dstData from '../../data/dst-crashes/results.json';
import { evidenceChart } from '../lib/charts/evidence.mjs';

interface Props { exhibit: 'ledger' | 'airport' | 'aviation' | 'pld' | 'dst'; compact?: boolean; }
interface Evidence { title: string; subtitle: string; source: string; provenance: string; summary: string }
const { exhibit, compact = false } = Astro.props;
const data = { ledger: ledgerData, airport: airportData, aviation: aviationMonths, pld: pldData, dst: dstData }[exhibit];
const { evidence: raw, html } = await evidenceChart(exhibit, data, { compact });
const evidence = raw as unknown as Evidence;
---
<figure class:list={['lab-evidence-chart', compact && 'lab-evidence-chart--compact']}>
  <figcaption class="lab-evidence-top">
    <span>
      <strong>{evidence.title}</strong>
      <small>{evidence.subtitle}</small>
    </span>
    <span class="lab-provenance">{evidence.provenance}</span>
  </figcaption>
  <Fragment set:html={html} />
  {!compact && <p class="lab-chart-interpretation">{evidence.summary}</p>}
  <p class="lab-chart-source">Source: <code>{evidence.source}</code> · derived at build time · not a live API read.</p>
</figure>
