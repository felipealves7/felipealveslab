 "description": "Daily mean of the 24 hourly power prices in R$/MWh, one panel per Brazilian submarket: SUDESTE, SUL, NORDESTE and NORTE, all on one scale from zero. Each panel title gives the highest daily mean in the period shown. The yearly figures are in the table below the chart.",
 "params": [
  {
   "name": "period",
   "value": "all"
  },
  {
   "name": "day",
   "value": null
  }
 ],
 "transform": [
  {
   "calculate": "datum.series.SUDESTE",
   "as": "SUDESTE"
  },
  {
   "calculate": "datum.series.SUL",
   "as": "SUL"
  },
  {
   "calculate": "datum.series.NORDESTE",
   "as": "NORDESTE"
  },
  {
   "calculate": "datum.series.NORTE",
   "as": "NORTE"
  },
  {
   "flatten": [
    "dates",
    "SUDESTE",
    "SUL",
    "NORDESTE",
    "NORTE"
   ]
  },
  {
   "filter": "period == 'all' || substring(datum.dates, 0, 4) == period"
  },
  {
   "calculate": "toDate(datum.dates + 'T00:00:00Z')",
   "as": "day_start"
  },
  {
   "fold": [
    "SUDESTE",
    "SUL",
    "NORDESTE",
    "NORTE"
   ],
   "as": [
    "submarket",
    "price"
   ]
  },
  {
   "calculate": "indexof(['SUDESTE', 'SUL', 'NORDESTE', 'NORTE'], datum.submarket)",
   "as": "order"
  },
  {
   "joinaggregate": [
    {
     "op": "argmax",
     "field": "price",
     "as": "peak"
    }
   ],
   "groupby": [
    "submarket"
   ]
  },
  {
   "calculate": "datum.submarket + ' · peak ' + format(datum.peak.price, ',.0f') + ' on ' + utcFormat(datum.peak.day_start, '%-d %b %Y')",
   "as": "panel"
  }
 ],
 "usermeta": {
  "generator": "charts/pld_daily.py",
  "live": {
   "params": [
    "period"
   ],
   "pick": {
    "mark": "line_marks",
    "by": "x",
    "signal": "day",
    "key": "dates",
    "readout": "readout_marks"
   }
  },
  "altair": "6.3.0"
 },
 "$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json"
}
