<mxfile host="app.diagrams.net" version="24.7.17" type="device"><diagram id="art01" name="Exception decision flow"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" value="&lt;div style=&quot;font-family:Arial;line-height:1.35;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#69715A;margin-bottom:8px;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;color:#1A1A17;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#545C50;margin-top:10px;&quot;&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F0EEE8;strokeColor=#F0EEE8;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1780" height="1000" as="geometry"/></mxCell><mxCell id="mast" value="&lt;div style=&quot;font-family:Arial;line-height:1.35;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#69715A;margin-bottom:8px;&quot;&gt;FELIPE ALVES LAB / AVIATION PRODUCT&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;color:#1A1A17;&quot;&gt;When evidence is incomplete, preserve uncertainty&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#545C50;margin-top:10px;&quot;&gt;Illustrative exception-resolution logic; source event provenance and auditability.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E4E8DD;strokeColor=#E4E8DD;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1780" height="150" as="geometry"/></mxCell><mxCell id="note" value="&lt;div style=&quot;font-family:Arial;line-height:1.35;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#69715A;margin-bottom:8px;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;color:#1A1A17;&quot;&gt;ILLUSTRATIVE DESIGN EXERCISE&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#545C50;margin-top:10px;&quot;&gt;Not a historical project artifact; no employer event data, design, or release decisions reproduced.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F1E4CA;strokeColor=#D3BD98;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="58" y="888" width="1664" height="57" as="geometry"/></mxCell><mxCell id="f0" value="&lt;div style=&quot;font-family:Arial;line-height:1.35;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#69715A;margin-bottom:8px;&quot;&gt;01 / OBSERVE&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;color:#1A1A17;&quot;&gt;Upstream event recorded&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#545C50;margin-top:10px;&quot;&gt;Acceptance event and source metadata are available.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F8F6F0;strokeColor=#C7C7BA;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="237" width="275" height="164" as="geometry"/></mxCell><mxCell id="f1" value="&lt;div style=&quot;font-family:Arial;line-height:1.35;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#69715A;margin-bottom:8px;&quot;&gt;02 / CORRELATE&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;color:#1A1A17;&quot;&gt;Second event recorded&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#545C50;margin-top:10px;&quot;&gt;A later event is linked to the same bag identifier.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F8F6F0;strokeColor=#C7C7BA;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="394" y="237" width="275" height="164" as="geometry"/></mxCell><mxCell id="f2" value="&lt;div style=&quot;font-family:Arial;line-height:1.35;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#69715A;margin-bottom:8px;&quot;&gt;03 / DECIDE&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;color:#1A1A17;&quot;&gt;Loading evidence?&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#545C50;margin-top:10px;&quot;&gt;Assess what the event feed actually establishes.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E5ECED;strokeColor=#9BABAC;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="729" y="237" width="285" height="164" as="geometry"/></mxCell><mxCell id="f3" value="&lt;div style=&quot;font-family:Arial;line-height:1.35;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#69715A;margin-bottom:8px;&quot;&gt;YES / CONFIRMED&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;color:#1A1A17;&quot;&gt;Loading confirmed&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#545C50;margin-top:10px;&quot;&gt;Valid confirmation establishes a known state.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E4E8DD;strokeColor=#B1C1AD;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1080" y="192" width="291" height="135" as="geometry"/></mxCell><mxCell id="f4" value="&lt;div style=&quot;font-family:Arial;line-height:1.35;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#69715A;margin-bottom:8px;&quot;&gt;NO / ABSENT&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;color:#1A1A17;&quot;&gt;State remains unknown&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#545C50;margin-top:10px;&quot;&gt;When confirmation is due, no event is not proof of non-loading.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F1E4CA;strokeColor=#D8C2A0;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1080" y="370" width="291" height="161" as="geometry"/></mxCell><mxCell id="f5" value="&lt;div style=&quot;font-family:Arial;line-height:1.35;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#69715A;margin-bottom:8px;&quot;&gt;04 / INVESTIGATE&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;color:#1A1A17;&quot;&gt;Open review task&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#545C50;margin-top:10px;&quot;&gt;Assign ownership for verification after checkpoint deadline.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F8F6F0;strokeColor=#C7C7BA;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1437" y="370" width="275" height="161" as="geometry"/></mxCell><mxCell id="f6" value="&lt;div style=&quot;font-family:Arial;line-height:1.35;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#69715A;margin-bottom:8px;&quot;&gt;05 / RESOLVE&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;color:#1A1A17;&quot;&gt;Close with audit trail&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#545C50;margin-top:10px;&quot;&gt;Record outcome, actor, evidence and reason.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E4E8DD;strokeColor=#B1C1AD;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1437" y="613" width="275" height="146" as="geometry"/></mxCell><mxCell id="f7" value="&lt;div style=&quot;font-family:Arial;line-height:1.35;&quot;&gt;&lt;div style=&quot;font-size:12px;font-weight:bold;color:#69715A;margin-bottom:8px;&quot;&gt;UPDATE PATH&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;color:#1A1A17;&quot;&gt;Late evidence arrives?&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#545C50;margin-top:10px;&quot;&gt;Re-evaluate status when reliable delayed events appear.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F8F6F0;strokeColor=#C7C7BA;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1080" y="613" width="291" height="146" as="geometry"/></mxCell><mxCell id="edge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#69715A;strokeWidth=2;" edge="1" parent="1" source="f0" target="f1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#69715A;strokeWidth=2;" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#69715A;strokeWidth=2;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#69715A;strokeWidth=2;" edge="1" parent="1" source="f2" target="f4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#69715A;strokeWidth=2;" edge="1" parent="1" source="f4" target="f5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#69715A;strokeWidth=2;" edge="1" parent="1" source="f5" target="f6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#69715A;strokeWidth=2;" edge="1" parent="1" source="f4" target="f7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#69715A;strokeWidth=2;" edge="1" parent="1" source="f7" target="f6"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>